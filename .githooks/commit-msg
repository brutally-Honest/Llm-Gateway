#!/bin/sh
# Enforces the commit conventions in PLAN.md §11.
# Enabled with: git config core.hooksPath .githooks

msg_file="$1"

# Ignore comment lines that git strips from the final message.
body=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$body" | sed -n '1p')

# Merge, revert and fixup commits written by git itself are exempt.
case "$subject" in
	"Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

fail() {
	printf '\ncommit-msg: %s\n\n' "$1" >&2
	printf 'Format (PLAN.md §11):\n' >&2
	printf '  <type>(<scope>): <imperative summary>\n\n  <1-3 sentence body>\n\n' >&2
	printf 'Types: feat fix refactor perf test docs build ci chore revert\n' >&2
	printf 'Your subject was:\n  %s\n\n' "$subject" >&2
	exit 1
}

types='feat|fix|refactor|perf|test|docs|build|ci|chore|revert'

printf '%s' "$subject" | grep -qE "^($types)\([a-z0-9-]+\)!?: .+$" ||
	fail 'subject does not match <type>(<scope>): <summary>'

[ "${#subject}" -le 72 ] ||
	fail "subject is ${#subject} characters; the limit is 72"

printf '%s' "$subject" | grep -qE '\.$' &&
	fail 'subject must not end with a period'

# No AI attribution. The repo owner is the author of record.
printf '%s\n' "$body" | grep -qiE '^co-authored-by:' &&
	fail 'Co-authored-by trailers are not allowed'

printf '%s\n' "$body" | grep -qiE 'generated with .*(claude|cursor|copilot|codex)|🤖' &&
	fail 'AI attribution lines are not allowed'

exit 0
